{
  "name": "pi-setup",
  "version": "0.1.0",
  "private": true,
  "description": "Personal pi setup — extensions and theme for my own pi workflow",
  "type": "module",
  "license": "MIT",
  "author": "lixxbox",
  "repository": {
    "type": "git",
    "url": "https://github.com/lixxbox/pi-setup"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "setup"
  ],
  "files": [
    "extensions",
    "themes",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!.github"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "pi": {
    "extensions": [
      "./extensions",
      "./node_modules/metes-pi-stuff/extensions/prd-loop-pro/index.ts",
      "./node_modules/metes-pi-stuff/extensions/todos/index.ts",
      "./node_modules/pi-ui-extension/extensions/index.ts"
    ],
    "skills": [
      "./skills",
      "./node_modules/metes-pi-stuff/skills/grill-me",
      "./node_modules/metes-pi-stuff/skills/write-a-prd",
      "./node_modules/metes-pi-stuff/skills/prd-to-todos",
      "./node_modules/agent-stuff/skills/web-browser",
      "./node_modules/agent-stuff/skills/github",
      "./node_modules/mattpocock-skills/skills/productivity/handoff"
    ],
    "themes": [
      "./themes"
    ]
  },
  "dependencies": {
    "agent-stuff": "github:mitsuhiko/agent-stuff",
    "mattpocock-skills": "github:mattpocock/skills",
    "metes-pi-stuff": "github:meteyou/pi-stuff",
    "pi-ui-extension": "^1.20.5",
    "ws": "^8.23.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@earendil-works/pi-ai": "^1.6.0",
    "@earendil-works/pi-coding-agent": "^1.6.0",
    "typebox": "^1.1.24",
    "typescript": "^5.0.0"
  }
}

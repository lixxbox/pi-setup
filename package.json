{
  "name": "pi-setup",
  "version": "0.1.0",
  "private": true,
  "description": "Personal pi setup — extensions and theme for my own pi workflow",
  "type": "module",
  "license": "MIT",
  "author": "lixxbox",
  "repository": {
    "type": "git",
    "url": "https://github.com/lixxbox/pi-setup"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "setup"
  ],
  "files": [
    "extensions",
    "themes",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!.github"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "themes": [
      "./themes"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@earendil-works/pi-ai": "^0.74.0",
    "@earendil-works/pi-coding-agent": "^0.74.0",
    "typebox": "^1.1.24",
    "typescript": "^5.0.0"
  }
}
